# Setas (Esquerda / Direita / Cima / Baixo):
# - Em leitura (menu fechado): virar páginas (Esquerda/Cima = próxima, Direita/Baixo = anterior)
# - No menu do livro ou fora da leitura: navegação 2D pelas opções
navLeft   EV_ABS ABS_X 147
navRight  EV_ABS ABS_X 778
navUp     EV_ABS ABS_Y 112
navDown   EV_ABS ABS_Y 880

# Botão OK (meio):
# - Em leitura (menu fechado): fechar o livro
# - No menu do livro ou fora da leitura: confirmar / abrir opção selecionada
# Nota: ABS_X 501 chega antes de ABS_Y 880, evitando conflito com navDown
ok        EV_ABS ABS_X 501

# Botão Câmara (fotos):
# - Em leitura: abrir/fechar o menu do livro (ou fechar janela aberta)
# - Fora da leitura: voltar ao ecrã anterior (ou fechar janela aberta)
menu      EV_ABS ABS_Y 450
